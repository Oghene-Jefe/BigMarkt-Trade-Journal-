SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WS_PORT=8080

# Shared secret required by the GET /status endpoint. The endpoint is now a
# trusted server→server channel — only the journal server should poll it.
# Generate a long random string (e.g. `openssl rand -base64 32`) and set
# the same value in the journal's WS_STATUS_SECRET env var.
WS_STATUS_SECRET=
