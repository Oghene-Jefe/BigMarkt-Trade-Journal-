SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WS_PORT=8080

# Shared secret required by the GET /status endpoint. /status is a trusted
# server→server channel — only the journal server should poll it. The
# journal also supplies a ?token_ids=… allow-list on each call, and the
# WS server filters connections against it before responding, so even a
# privileged caller can't read the global active-connection map.
# Generate a long random string (e.g. `openssl rand -base64 32`) and set
# the same value in the journal's WS_STATUS_SECRET env var.
WS_STATUS_SECRET=
