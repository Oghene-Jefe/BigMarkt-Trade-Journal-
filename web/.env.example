# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Canonical public URL of this journal app. Used to lock the password-reset
# redirect so it always returns to your own domain. Example:
# https://journal.bigmarkt.co
NEXT_PUBLIC_SITE_URL=https://your-journal-domain.example.com

# Used by: (1) server-side tests (privacy.spec.ts), (2) web/app/api/ea/ingest/route.ts —
# EA bearer-token auth bypasses RLS by design. Never import in client components or any
# route that uses Supabase session auth.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Master key for envelope encryption of exchange API credentials. Generate
# with: openssl rand -base64 32
# Set in Vercel Production + Preview as a Sensitive env var. Never commit.
# See web/docs/EXCHANGE_SECURITY.md for rotation procedure + threat model.
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# Cloudflare Turnstile bot protection for signup and public forms. Production
# fails closed unless TURNSTILE_SECRET_KEY is set. Only use
# ALLOW_INSECURE_NO_TURNSTILE in local development.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
# ALLOW_INSECURE_NO_TURNSTILE=false

# Optional Bybit egress proxy. Use when the deployment host is blocked by
# Bybit/CloudFront. The proxy must forward the full path/query and all
# X-BAPI-* headers to Bybit without logging credentials.
# BYBIT_MAINNET_BASE_URL=https://bigmarkt-bybit-proxy.example.workers.dev/mainnet
# BYBIT_TESTNET_BASE_URL=https://bigmarkt-bybit-proxy.example.workers.dev/testnet
# BYBIT_PROXY_TOKEN=shared-secret-between-vercel-and-proxy

# WebSocket status polling. The journal's /ea-setup page polls the WS
# server's protected /status endpoint via these. Set both on Vercel
# Production + Preview. Generate the secret with:  openssl rand -base64 32
# WS_STATUS_URL=https://your-railway-ws-host/status
# WS_STATUS_SECRET=must-match-the-value-set-on-the-WS-server

# Vercel cron auth. Vercel injects this as `Authorization: Bearer …` on
# scheduled cron invocations. The cron routes refuse to run if unset.
# CRON_SECRET=long-random-string

# AES-256-GCM master key used to encrypt EA v2 per-token signing secrets at
# rest in the database. Required for EA token generation and v2 ingest.
# Generate with: openssl rand -base64 32
# Set as a Sensitive env var in Vercel. Never commit.
EA_SIGNING_SECRET_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# AES-256-GCM master key used to encrypt MetaApi reader-scoped tokens at rest.
# Required before MetaApi provisioning or sync is enabled. Generate with:
# openssl rand -base64 32
# Set as a Sensitive env var in Vercel. Never commit.
# METAAPI_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# ISO-8601 datetime after which v1 EA ingest requests are rejected outright.
# Leave blank (or omit) to keep accepting v1 indefinitely — a deprecation
# warning is still logged. Example cutoff: 2026-09-01T00:00:00Z
# EA_INGEST_V1_CUTOFF_AT=
