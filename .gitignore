node_modules/
.next/
dist/
build/
out/
coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp

# ── Tooling caches ──────────────────────────────────────────────────────
.npm-cache/
.cache/
